--cpu=Cortex-M4.fp.sp
"test_clock\startup_stm32g474xx.o"
"test_clock\main.o"
"test_clock\gpio.o"
"test_clock\stm32g4xx_it.o"
"test_clock\stm32g4xx_hal_msp.o"
"test_clock\stm32g4xx_hal_tim.o"
"test_clock\stm32g4xx_hal_tim_ex.o"
"test_clock\stm32g4xx_hal_pwr_ex.o"
"test_clock\stm32g4xx_hal.o"
"test_clock\stm32g4xx_hal_rcc.o"
"test_clock\stm32g4xx_hal_rcc_ex.o"
"test_clock\stm32g4xx_hal_flash.o"
"test_clock\stm32g4xx_hal_flash_ex.o"
"test_clock\stm32g4xx_hal_flash_ramfunc.o"
"test_clock\stm32g4xx_hal_gpio.o"
"test_clock\stm32g4xx_hal_exti.o"
